# Anthropic API klic (nastav na Vercelu jako Environment Variable, ne do gitu)
ANTHROPIC_API_KEY=sk-ant-...
# Volitelne: prepnuti modelu (default claude-sonnet-5). Napr. claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5
# URL Google Apps Script web app pro sber pripominek (viz docs/pripominky-apps-script.md)
FEEDBACK_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
