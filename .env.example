# --- Supabase ---
# Najdeš v Supabase projektu: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Tajný klíč, POUZE pro server (nikdy nedávat do prohlížeče / NEXT_PUBLIC_).
# Používá se pro administraci uživatelů (pozvání nového čtenáře/editora).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (posílání e-mailů o změnách) ---
# Najdeš na resend.com po vytvoření účtu a ověření domény/e-mailu
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="AI kurikulum <notifikace@tvoje-domena.cz>"

# --- Appka ---
# Veřejná URL appky (lokálně http://localhost:3000, na Vercelu URL projektu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
